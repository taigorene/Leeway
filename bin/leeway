#!/usr/bin/env bash
# Lança o app de barra de menus do Leeway.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"

if [ ! -x "$VENV/bin/python" ]; then
  echo "==> Criando ambiente virtual…"
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt"
fi

# Garante que o rumps está presente (caso o venv tenha sido criado só p/ testes).
if ! "$VENV/bin/python" -c "import rumps" >/dev/null 2>&1; then
  "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt"
fi

exec env PYTHONPATH="$ROOT/src" "$VENV/bin/python" -m leeway.app
